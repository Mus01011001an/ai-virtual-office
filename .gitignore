# Custom excluded folders

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Node modules and packages
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
# Except example files
!.env.example
!.env.template

# Build outputs and caches
dist/
build/
out/
.next/
.nuxt/
.cache/
.vuepress/dist
.serverless/
.parcel-cache/
.vite/

