// Kredensial & konfigurasi server Model Context Protocol (MCP) per company.
model McpServer {
  id          String    @id @default(uuid())
  companyId   String
  name        String    // nama server, misal: "filesystem", "github", "brave-search"
  description String?
  transport   String    @default("sse") // "sse" | "http" | "stdio"
  url         String    // URL SSE/HTTP atau command path stdio
  headers     Json?     // custom HTTP headers / bearer token (encrypted or plaintext key-values)
  env         Json?     // environment variables untuk stdio
  isEnabled   Boolean   @default(true)
  toolsCache  Json?     // snapshot tool definitions dari tools/list
  lastSyncAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, name])
  @@index([companyId])
  @@map("mcp_server")
}
