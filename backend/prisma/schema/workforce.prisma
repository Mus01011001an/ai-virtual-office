// AI employee, task, dan feed aktivitas agent. Field Employee disamakan dengan frontend/src/state/types.ts.

enum EmployeeStatus {
  IDLE
  WORKING
  THINKING
  TOOL_EXECUTING
  WAITING
  ON_BREAK
  IN_MEETING
  COLLABORATING
  OFFLINE
}

enum TaskStatus {
  QUEUED
  EXECUTING
  WAITING
  COMPLETED
  FAILED
  CANCELLED
}

model Employee {
  id           String         @id @default(uuid())
  companyId    String
  name         String         @default("")
  role         String         @default("")
  department   String         @default("")
  /// nama provider (tampilan); sumber kebenaran = providerId
  provider     String         @default("")
  providerId   String?
  model        String         @default("")
  skills       String[]       @default([])
  systemPrompt String         @default("") @db.Text
  deskIndex    Int
  /// skin/hair/hairStyle/top/bottom/shoes/height/glasses/jacket (frontend lib/appearance.ts)
  appearance   Json           @default("{}")
  /// Konfigurasi profil suara unik: { "voiceId": string, "pitch": number, "rate": number, "gender": "male"|"female"|"neutral", "provider": "webspeech" }
  voiceProfile Json           @default("{\"pitch\":1.0,\"rate\":1.0,\"gender\":\"neutral\",\"provider\":\"webspeech\"}")
  activeSessionIndex Int        @default(1)
  accumulatedSummary String?    @db.Text
  status       EmployeeStatus @default(IDLE)
  slot         Int?
  currentTask  String?
  currentTool  String?
  progress     Float          @default(0)
  isDemo       Boolean        @default(false)
  createdById  String?
  updatedById  String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  deletedAt    DateTime?

  company      Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  aiProvider   AiProvider?        @relation(fields: [providerId], references: [id], onDelete: SetNull)
  tasks        Task[]
  activities   EmployeeActivity[]
  artifacts    Artifact[]
  usageRecords UsageRecord[]
  approvals    ApprovalRequest[]
  files        AgentFile[]
  sessionMemories AgentSessionMemory[]

  @@index([companyId, status])
  @@index([companyId, deletedAt])
  @@map("employee")
}

model Task {
  id          String     @id @default(uuid())
  companyId   String
  employeeId  String
  title       String     @default("")
  description String?    @db.Text
  status      TaskStatus @default(QUEUED)
  /// panel | discussion | api
  source      String     @default("panel")
  isDemo      Boolean    @default(false)
  createdById String?
  startedAt   DateTime?
  finishedAt  DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee     Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  events       TaskEvent[]
  artifacts    Artifact[]
  usageRecords UsageRecord[]
  approvals    ApprovalRequest[]

  @@index([companyId, status])
  @@index([employeeId, createdAt])
  @@map("task")
}

model TaskEvent {
  id        String      @id @default(uuid())
  taskId    String
  from      TaskStatus?
  to        TaskStatus
  note      String?
  actorId   String?
  createdAt DateTime    @default(now())
  task      Task        @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
  @@map("task_event")
}

/// Feed aktivitas agent (monitor, workstation, panel) — terpisah dari ActivityLog (audit user).
model EmployeeActivity {
  id         String   @id @default(uuid())
  companyId  String
  employeeId String
  /// status | info | tool | output | ai | warn | error | instruction | done
  kind       String   @default("info")
  text       String   @default("") @db.Text
  createdAt  DateTime @default(now())

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, createdAt])
  @@index([companyId, createdAt])
  @@map("employee_activity")
}

model Artifact {
  id          String   @id @default(uuid())
  companyId   String
  employeeId  String?
  taskId      String?
  name        String   @default("")
  mimeType    String   @default("text/plain")
  size        Int      @default(0)
  s3Key       String   @default("")
  url         String?  @db.Text
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  task     Task?     @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([companyId, createdAt])
  @@index([employeeId, createdAt])
  @@index([taskId])
  @@map("artifact")
}

model UsageRecord {
  id               String   @id @default(uuid())
  companyId        String
  employeeId       String?
  taskId           String?
  providerId       String?
  model            String   @default("")
  promptTokens     Int      @default(0)
  completionTokens Int      @default(0)
  totalTokens      Int      @default(0)
  estimatedCost    Float    @default(0.0)
  durationMs       Int      @default(0)
  createdAt        DateTime @default(now())

  company    Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee   Employee?   @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  task       Task?       @relation(fields: [taskId], references: [id], onDelete: SetNull)
  aiProvider AiProvider? @relation(fields: [providerId], references: [id], onDelete: SetNull)

  @@index([companyId, createdAt])
  @@index([employeeId, createdAt])
  @@index([taskId])
  @@map("usage_record")
}

model StandupReport {
  id          String   @id @default(uuid())
  companyId   String
  date        String
  summary     String   @db.Text
  attendees   String[] @default([])
  /// [{ "employeeId": string, "name": string, "yesterday": string, "today": string, "blockers": string }]
  reports     Json     @default("[]")
  createdAt   DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, date])
  @@index([companyId, createdAt])
  @@map("standup_report")
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

enum ApprovalRiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum WebhookChannel {
  TELEGRAM
  DISCORD
  SLACK
  GENERIC_HTTP
}

model ApprovalRequest {
  id           String            @id @default(uuid())
  companyId    String
  taskId       String?
  employeeId   String?
  toolName     String
  riskLevel    ApprovalRiskLevel @default(MEDIUM)
  status       ApprovalStatus    @default(PENDING)
  title        String            @default("")
  description  String?           @db.Text
  inputPayload Json              @default("{}")
  outputResult Json?
  reviewerId   String?
  reviewNote   String?           @db.Text
  expiresAt    DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  task     Task?     @relation(fields: [taskId], references: [id], onDelete: SetNull)
  employee Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)

  @@index([companyId, status])
  @@index([taskId])
  @@index([employeeId])
  @@index([companyId, createdAt])
  @@map("approval_request")
}

model WebhookConfig {
  id          String         @id @default(uuid())
  companyId   String
  channel     WebhookChannel
  name        String         @default("")
  url         String         @db.Text
  /// Token atau secret HMAC terenkripsi (AES-256)
  secret      String?        @db.Text
  events      String[]       @default([])
  isActive    Boolean        @default(true)
  metadata    Json           @default("{}")
  createdById String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, channel])
  @@index([companyId, isActive])
  @@map("webhook_config")
}

// File virtual Antigravity-style per agent (PERSONA.md, RULES.md, skills/*.md, KNOWLEDGE.md, config.json)
model AgentFile {
  id         String   @id @default(uuid())
  employeeId String
  companyId  String
  path       String   // e.g. "PERSONA.md", "RULES.md", "skills/code-review.md", "KNOWLEDGE.md"
  name       String   // display name
  content    String   @db.Text
  fileType   String   @default("markdown") // "markdown" | "json" | "text"
  isReadonly Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([employeeId, path])
  @@index([employeeId])
  @@index([companyId])
  @@map("agent_file")
}

// Memori jangka panjang permanen agent (Episodic context summary & past milestones)
model AgentSessionMemory {
  id             String    @id @default(uuid())
  employeeId     String
  companyId      String
  sessionIndex   Int       @default(1)
  summaryContext String    @db.Text // Rangkuman milestone, keputusan, dan hasil kerja
  tokenCount     Int       @default(0)
  resetReason    String?   // "manual_reset" | "context_threshold" | "shift_change"
  lastTaskTitle  String?
  createdAt      DateTime  @default(now())

  employee       Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  company        Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([companyId])
  @@map("agent_session_memory")
}
