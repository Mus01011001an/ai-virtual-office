NODE_ENV=development
PORT=8010
CORS_ORIGIN=http://localhost:5173
TRUSTED_ORIGINS=http://localhost:5173
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/virtual_office"
# Maks koneksi pool pg per instance backend
DB_POOL_MAX=10
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:8010

# MinIO / S3 Compatible
S3_REGION=us-east-1
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=
# Opsional: URL publik S3 untuk browser (tanpa bucket)
S3_PUBLIC_URL=
S3_PREFIX=virtual-office

# Phase 3 (AI Engine)
REDIS_URL=redis://localhost:6379

# Express trust proxy untuk rate limiter (default: loopback, linklocal, uniquelocal)
TRUST_PROXY=
